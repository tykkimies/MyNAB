# Merge this location into your existing HTTPS server. Keep your own certificates.
# For host nginx use 127.0.0.1:3000. For container nginx use app:3000 on NGINX_NETWORK.
location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    client_max_body_size 16k;
    proxy_read_timeout 60s;
}
# Redirect port 80 to your exact HTTPS host. Do not log bodies, cookies, or credentials.
# Increase upload limits deliberately when file importing is implemented.
