# Copy to .env; chmod 600 .env. Never commit real values.
# Generate BOTH values independently with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
SECRET_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
POSTGRES_USER=mynab
POSTGRES_DB=mynab
# Keep password consistent with POSTGRES_PASSWORD. Hex passwords need no URL escaping.
DATABASE_URL=postgresql://mynab:REPLACE_WITH_RANDOM_HEX_PASSWORD@db:5432/mynab
# Exact public origin, no trailing slash. Production requires HTTPS.
APP_ORIGIN=https://money.example.com
# Default is host nginx on loopback. For container nginx use docs/compose.proxy.yml.
APP_BIND=127.0.0.1
APP_PORT=3000
# Used only with the optional container-nginx override.
NGINX_NETWORK=proxy

# Set before building for subpath hosting. Changing this requires rebuilding images.
APP_BASE_PATH=

# SimpleFIN Bridge bank sync; on by default, needs no secret here.
# SIMPLEFIN=on
# Phone push for debt reminders through ntfy. Off while NTFY_TOPIC is unset.
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=a-long-random-topic-name
# NTFY_TOKEN=
# NTFY_DETAIL=minimal
