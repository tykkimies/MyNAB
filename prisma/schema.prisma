generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuditAction {
  OWNER_CREATED
  PASSWORD_RESET
  LOGIN_SUCCEEDED
  LOGOUT
  FINANCE_COMMAND
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(64)
  passwordHash String
  authVersion  Int      @default(1)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  installation Installation?
  memberships  BudgetMember[]
  sessions     Session[]
  auditEvents  AuditEvent[]
}

model Installation {
  id          Int    @id @default(1)
  ownerId     String @unique @db.Uuid
  owner       User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
}

model Budget {
  id        String   @id @default(uuid()) @db.Uuid
  financeRevision Int @default(0)
  name      String   @db.VarChar(120)
  currency  String   @default("USD") @db.VarChar(3)
  timezone  String   @default("America/New_York") @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  members   BudgetMember[]
  auditEvents AuditEvent[]
}

model BudgetMember {
  budgetId String @db.Uuid
  userId   String @db.Uuid
  role     String @default("owner") @db.VarChar(16)
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([budgetId, userId])
  @@index([userId])
}

model Session {
  tokenHash   String   @id @db.VarChar(64)
  userId      String   @db.Uuid
  authVersion Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model LoginThrottle {
  key         String   @id @db.VarChar(64)
  windowStart DateTime @db.Timestamptz(3)
  attempts    Int
}

model AuditEvent {
  id        String      @id @default(uuid()) @db.Uuid
  actorId   String?     @db.Uuid
  budgetId  String?     @db.Uuid
  details   Json?
  action    AuditAction
  entityId  String      @db.Uuid
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: Restrict)
  budget    Budget?     @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  @@index([budgetId, createdAt])
  @@index([actorId, createdAt])
}

// Budget ownership and compound financial references are enforced in migration SQL.
model FinancialAccount {
 id String @id @default(uuid()) @db.Uuid
 budgetId String @db.Uuid
 name String @db.VarChar(120)
 type String @db.VarChar(24)
 participation String @db.VarChar(16)
 closed Boolean @default(false)
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([id,budgetId])
 @@index([budgetId])
}
model CategoryGroup {
 id String @id @default(uuid()) @db.Uuid
 budgetId String @db.Uuid
 name String @db.VarChar(120)
 system Boolean @default(false)
 @@unique([id,budgetId])
}
model Category {
 id String @id @default(uuid()) @db.Uuid
 budgetId String @db.Uuid
 groupId String @db.Uuid
 name String @db.VarChar(120)
 archived Boolean @default(false)
 // Owner-managed categories only. System categories such as Uncategorized and card
 // payment reserves are maintained by the application and cannot be edited away.
 system Boolean @default(false)
 paymentAccountId String? @unique @db.Uuid
 @@unique([id,budgetId])
 @@index([budgetId])
}
model Journal {
 id String @id @default(uuid()) @db.Uuid
 budgetId String @db.Uuid
 date DateTime @db.Date
 reversesId String? @unique @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([id,budgetId])
}
model Posting {
 id String @id @default(uuid()) @db.Uuid
 budgetId String @db.Uuid
 journalId String @db.Uuid
 accountId String? @db.Uuid
 systemAccount String? @db.VarChar(16)
 amount BigInt
 @@index([journalId])
 @@index([accountId])
}
model FinancialTransaction {
 id String @id @default(uuid()) @db.Uuid
 budgetId String @db.Uuid
 journalId String @unique @db.Uuid
 accountId String @db.Uuid
 transferAccountId String? @db.Uuid
 kind String @db.VarChar(16)
 date DateTime @db.Date
 amount BigInt
 payee String @default("") @db.VarChar(120)
 memo String @default("") @db.VarChar(500)
 voidedAt DateTime? @db.Timestamptz(3)
 voidReason String? @db.VarChar(500)
 replacesId String? @unique @db.Uuid
 refundOfId String? @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([id,budgetId])
 @@index([budgetId,date])
}
model FinancialSplit {
 id String @id @default(uuid()) @db.Uuid
 budgetId String @db.Uuid
 transactionId String @db.Uuid
 categoryId String @db.Uuid
 amount BigInt
 position Int
 @@unique([transactionId,position])
}
model TransactionState {
 transactionId String @db.Uuid
 accountId String @db.Uuid
 budgetId String @db.Uuid
 cleared Boolean @default(false)
 reconciliationId String? @db.Uuid
 @@id([transactionId,accountId])
}
model BudgetAssignment {
 id String @id @default(uuid()) @db.Uuid
 budgetId String @db.Uuid
 categoryId String @db.Uuid
 month String @db.VarChar(7)
 amount BigInt
 moveId String? @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([budgetId,month])
}
model Reconciliation {
 id String @id @default(uuid()) @db.Uuid
 budgetId String @db.Uuid
 accountId String @db.Uuid
 date DateTime @db.Date
 observed BigInt
 calculated BigInt
 affectedAt DateTime? @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([id,budgetId])
 @@index([accountId,createdAt])
}
model ReconciliationItem {
 reconciliationId String @db.Uuid
 transactionId String @db.Uuid
 accountId String @db.Uuid
 budgetId String @db.Uuid
 @@id([reconciliationId,transactionId,accountId])
}
model FinanceRequest {
 budgetId String @db.Uuid
 key String @db.Uuid
 payloadHash String @db.VarChar(64)
 result Json
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@id([budgetId,key])
}

// Provider ingestion (Phase 5). Adapters never write ledger tables; see
// docs/PHASE5_INGESTION.md. Access tokens are stored only as AES-GCM envelopes.
model ProviderConnection {
 id String @id @default(uuid()) @db.Uuid
 budgetId String @db.Uuid
 provider String @db.VarChar(16)
 institutionId String @db.VarChar(64)
 institutionName String @db.VarChar(120)
 accessToken String @db.VarChar(1024)
 cursor String? @db.VarChar(1024)
 status String @default("ACTIVE") @db.VarChar(24)
 errorCode String? @db.VarChar(64)
 // Held across the provider HTTP call, which happens outside any DB transaction.
 syncToken String? @db.Uuid
 syncingSince DateTime? @db.Timestamptz(3)
 lastSyncedAt DateTime? @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([id,budgetId])
 @@index([budgetId])
}
model ProviderAccount {
 id String @id @default(uuid()) @db.Uuid
 budgetId String @db.Uuid
 connectionId String @db.Uuid
 externalAccountId String @db.VarChar(128)
 name String @db.VarChar(120)
 mask String @default("") @db.VarChar(16)
 type String @db.VarChar(32)
 // Null until the owner explicitly links it. Unlinked accounts are never synced.
 accountId String? @unique @db.Uuid
 // The owner's opening balance already covers everything before this date, so
 // importing earlier history would double count it and invent unassigned months.
 linkedFrom DateTime? @db.Date
 @@unique([id,budgetId])
 @@unique([connectionId,externalAccountId])
 @@index([budgetId])
}
model IngestedEntry {
 id String @id @default(uuid()) @db.Uuid
 budgetId String @db.Uuid
 connectionId String @db.Uuid
 providerAccountId String @db.Uuid
 externalId String @db.VarChar(128)
 pendingExternalId String? @db.VarChar(128)
 status String @db.VarChar(8)
 date DateTime @db.Date
 amount BigInt
 payee String @default("") @db.VarChar(120)
 transactionId String? @db.Uuid
 removed Boolean @default(false)
 review Json?
 approved Boolean @default(false)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([connectionId,externalId])
 @@index([transactionId])
 @@index([budgetId,approved])
}
model DeclinedMatch {
 budgetId String @db.Uuid
 connectionId String @db.Uuid
 externalId String @db.VarChar(128)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@id([connectionId,externalId])
}

// A target describes what a category needs. It never assigns money by itself.
// Effective-dated versions retain historical targets; completion is derived from ledger replay.
model CategoryTarget {
 categoryId String @db.Uuid
 budgetId String @db.Uuid
 type String @db.VarChar(20)
 amount BigInt
 dueMonth String? @db.VarChar(7)
 cadenceMonths Int?
 // YNAB's refill/set-aside toggle, and which weekday a weekly target recurs on.
 refill Boolean @default(false)
 dayOfWeek Int?
 // The month this version takes effect. Editing a target adds a version rather
 // than rewriting what earlier months were asked to do.
 effectiveFrom String @default("1900-01") @db.VarChar(7)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@id([categoryId,effectiveFrom])
 @@unique([categoryId,budgetId,effectiveFrom])
 @@index([budgetId])
}

// Contract terms the ledger cannot know. Balances are always derived from the
// ledger; nothing here is a scenario or a projection.
model DebtTerms {
 accountId String @db.Uuid
 budgetId String @db.Uuid
 aprBasisPoints Int
 minimumPayment BigInt
 dueDay Int?
 creditLimit BigInt?
 // A rate that changes, such as a promotional period ending, is a later
 // version rather than an edit of this one.
 effectiveFrom String @default("1900-01") @db.VarChar(7)
 updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
 @@unique([accountId,budgetId,effectiveFrom])
 @@index([budgetId])
}

model Schedule {
 id String @id @default(uuid()) @db.Uuid
 budgetId String @db.Uuid
 accountId String @db.Uuid
 transferAccountId String? @db.Uuid
 name String @db.VarChar(120)
 kind String @db.VarChar(16)
 amount BigInt
 payee String @db.VarChar(120)
 memo String @db.VarChar(500)
 startDate DateTime @db.Date
 endDate DateTime? @db.Date
 timezone String @db.VarChar(64)
 cadence String @db.VarChar(8)
 interval Int @default(1)
 revision Int @default(1)
 replacedById String? @db.Uuid
 archived Boolean @default(false)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([id,budgetId])
 @@index([budgetId,archived])
}
model ScheduleSplit {
 scheduleId String @db.Uuid
 budgetId String @db.Uuid
 categoryId String @db.Uuid
 amount BigInt
 position Int
 @@id([scheduleId,position])
}
model ScheduleOccurrence {
 scheduleId String @db.Uuid
 budgetId String @db.Uuid
 date DateTime @db.Date
 transactionId String? @unique @db.Uuid
 matched Boolean @default(false)
 status String @db.VarChar(8)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@id([scheduleId,date])
 @@index([budgetId,date])
}

model AutomationRule {
 id String @id @default(uuid()) @db.Uuid
 budgetId String @db.Uuid
 name String @db.VarChar(120)
 priority Int @default(100)
 enabled Boolean @default(true)
 revision Int @default(1)
 accountId String? @db.Uuid
 payeeMatch String? @db.VarChar(120)
 matchMode String @default("CONTAINS") @db.VarChar(8)
 descriptionContains String? @db.VarChar(500)
 minimum BigInt?
 maximum BigInt?
 renamePayee String? @db.VarChar(120)
 categoryId String? @db.Uuid
 memo String? @db.VarChar(500)
 tags String[] @default([])
 transferAccountId String? @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([id,budgetId])
 @@index([budgetId,priority,id])
}

model TransactionPreference {
 transactionId String @id @db.Uuid
 budgetId String @db.Uuid
 tags String[] @default([])
 locked String[] @default([])
 revision Int @default(1)
 @@index([budgetId])
}

model RecurringDismissal {
 budgetId String @db.Uuid
 key String @db.VarChar(500)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@id([budgetId,key])
}
